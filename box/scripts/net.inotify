#!/system/bin/sh

events=$1

# Network changes can be reported as write/create/delete/move events.
# Do not restrict this handler to "w": Android may report interface/routing
# changes with other event types.
[ -f "/data/adb/box/run/box.pid" ] || exit 0

export PATH="/data/adb/magisk:/data/adb/ksu/bin:/data/adb/ap/bin:$PATH:/system/bin"

buildVersion=$(getprop ro.build.version.release)
minBuildVersion="11"
IPV="iptables"
IP6V="ip6tables"
buildVersionMajor=${buildVersion%%.*}
if [ "$buildVersionMajor" -ge "$minBuildVersion" ]; then
  IPV="iptables -w 100"
  IP6V="ip6tables -w 100"
fi

iptables="${IPV}"
ip6tables="${IP6V}"
logs="/data/adb/box/run"

# Let Android finish replacing the cellular interface/address before reading it.
sleep 2

rules_add() {
  date >> "${logs}/net.log"

  # LOCAL_IP_* may not exist in TUN mode.  Never let this diagnostic refresh
  # interfere with the network recovery path.
  ${iptables} -t mangle -F LOCAL_IP_V4 >/dev/null 2>&1 || true
  ${iptables} -t nat -F LOCAL_IP_V4 >/dev/null 2>&1 || true

  ip -4 a | busybox awk '/inet/ {print $2}' | grep -vE "^127.0.0.1" | while read -r local_ipv4 ; do
    ${iptables} -t mangle -A LOCAL_IP_V4 -d "$local_ipv4" -j ACCEPT >/dev/null 2>&1
    rv1=$?
    ${iptables} -t nat -A LOCAL_IP_V4 -d "$local_ipv4" -j ACCEPT >/dev/null 2>&1
    rv2=$?
    ( [ $rv1 = "0" ] || [ $rv2 = "0" ] ) && echo "[Info]: local ip is $local_ipv4, anti-loopback rule has been inserted" >> "${logs}/net.log"
  done

  ${ip6tables} -t mangle -F LOCAL_IP_V6 >/dev/null 2>&1 || true
  ip -6 a | busybox awk '/inet6/ {print $2}' | grep -vE "^fe80|^::1|^fd00" | while read -r local_ipv6 ; do
    ${ip6tables} -t mangle -A LOCAL_IP_V6 -d "$local_ipv6" -j ACCEPT >/dev/null 2>&1
    [ $? = "0" ] && echo "[Info]: local ip is $local_ipv6, anti-loopback rule has been inserted" >> "${logs}/net.log"
  done
}

rules_add
